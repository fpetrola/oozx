<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>oozx</artifactId>
    <groupId>com.fpetrola</groupId>
    <version>0.0.1-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>minizx3d</artifactId>
  <build>
    <resources>
      <resource>
        <directory>..</directory>
        <includes>
          <include>Jet Set Willy - Mildly Patched.rzx</include>
          <include>analysis/jsw-catalog.db</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>jsw3d-demo</finalName>
              <artifactSet>
                <excludes>
                  <exclude>org.soot-oss:*</exclude>
                  <exclude>fr.inria.gforge.spoon:*</exclude>
                  <exclude>org.eclipse.jdt:*</exclude>
                  <exclude>org.easymock:*</exclude>
                  <exclude>org.mockito:*</exclude>
                  <exclude>net.bytebuddy:*</exclude>
                  <exclude>org.openjdk.nashorn:*</exclude>
                  <exclude>com.github.weisj:*</exclude>
                  <exclude>com.fifesoft:*</exclude>
                  <exclude>org.jgrapht:*</exclude>
                  <exclude>org.smali:*</exclude>
                  <exclude>com.github.javaparser:*</exclude>
                  <exclude>com.google.protobuf:*</exclude>
                  <exclude>com.fasterxml.jackson.core:*</exclude>
                  <exclude>com.fasterxml.woodstox:*</exclude>
                </excludes>
              </artifactSet>
              <transformers>
                <transformer>
                  <mainClass>com.fpetrola.z80.minizx3d.JSW3D</mainClass>
                </transformer>
                <transformer />
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.easymock</groupId>
      <artifactId>easymock</artifactId>
      <version>5.1.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>1.15.11</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <version>5.7.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.openjdk.nashorn</groupId>
      <artifactId>nashorn-core</artifactId>
      <version>15.6</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.16.0</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
  <properties>
    <gdx.version>1.12.1</gdx.version>
  </properties>
</project>
