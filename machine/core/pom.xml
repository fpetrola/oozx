    <build>
        <plugins>
            <!--
              The test harness and the test files - ROMs, tapes, recordings - are shared with the
              application's tests, which is where the tests that need a whole program moved to.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>

            <!-- One class decides what runs: model.suites.FastSuite. Everything else is reached
                 through it or asked for by name, as in -Dtest=SlowSuite or -Dtest=CpuSuite. The fork
                 timeout is a backstop: the command bridge spins on a queue a stopped machine never
                 feeds, and a spin cannot be interrupted from inside. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <!-- surefire's defaults stop at *Test/*Tests, so a name ending in a digit
                             (SpeccyUnitTests1) was never picked up and its tests never ran. -->
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*Tests?.java</include>
                    </includes>
                    <reuseForks>false</reuseForks>
                    <forkedProcessTimeoutInSeconds>120</forkedProcessTimeoutInSeconds>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version> <!-- Use a recent version -->
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.fpetrola.oozx.fuse.OOSpectrumLauncher</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <descriptors>
                        <descriptor>src/main/assembly/distribution.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id> <!-- This is used for inheritance merges -->
                        <phase>package</phase> <!-- Bind to the packaging phase -->
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version> <!-- Use a recent version -->
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.fpetrola.oozx.fuse.OOSpectrumLauncher</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- The slow, networked and native-only tests never run in a normal build. Ask for them:
         mvn test -Pslow -pl machine/core -->
    <profiles>
        <profile>
            <id>slow</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/suites/SlowSuite.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <oozx.slow>true</oozx.slow>
                                <oozx.network>true</oozx.network>
                                <oozx.native>true</oozx.native>
                            </systemPropertyVariables>
                            <forkedProcessTimeoutInSeconds>1800</forkedProcessTimeoutInSeconds>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
