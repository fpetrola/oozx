<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fpetrola</groupId>
        <artifactId>machine</artifactId>
        <version>0.0.2-alu-SNAPSHOT</version>
    </parent>

    <artifactId>devices</artifactId>
    <packaging>pom</packaging>

    <name>devices</name>

    <!--
      What a board is made of, not the boards. The window shapes a bay or a socket takes, and the
      ATA code more than one of them talks: a plugin is built against these, so they are here and
      not with the plugins.

      The plugins are fpetrola/oozx-plugins, a repository of its own built against this one. The
      emulator does not depend on them and does not know which exist: it finds them through
      META-INF/services, which is the whole point of the arrangement.
    -->
    <modules>
        <module>ide</module>
        <module>kit</module>
    </modules>

    <!-- A jar says in its manifest which jars it was built against, the way a plugin's does. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>machines</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The emulator's test harness: a machine to run a test on, and the loops that run it. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
