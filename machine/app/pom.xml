<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fpetrola</groupId>
        <artifactId>machine</artifactId>
        <version>0.0.2-alu-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <packaging>jar</packaging>

    <name>app</name>

    <!--
      The program: the desktop, its windows and menus, the launcher, and main(). Everything that
      knows there is a person here.

      It sits on top of everything and nothing sits on it, which is the whole point: the emulator
      does not know this exists, and neither does a peripheral.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>ui</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
        </dependency>
        <!-- The peripherals this build offers. Nothing here names one; they arrive by service file. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>devices-all</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
        </dependency>
        <!-- The Slow tag, which lives in the most upstream module so every module shares it. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>emulator</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- The emulator's test harness and its ROMs, tapes and recordings. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The scaler: see the note in core's pom, which explains why it is a dependency and not a copy. -->
        <dependency>
            <groupId>io.github.stanio</groupId>
            <artifactId>xbrz-core</artifactId>
            <version>1.8.2</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.jamepad</groupId>
            <artifactId>jamepad</artifactId>
            <version>2.30.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-transcoder</artifactId>
            <version>1.17</version>
        </dependency>
    </dependencies>

    <!-- Un solo jar ejecutable: mvn -o package -pl machine/app -am -DskipTests
         y despues java -jar machine/app/target/app-<version>.jar
         Los perifericos llegan por service file, asi que las entradas de META-INF/services
         de todos los modulos se concatenan en vez de pisarse. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.fpetrola.oozx.speccy.OOSpectrumLauncher</mainClass>
                                    <manifestEntries>
                                        <!-- El look and feel entra por reflexion a JRootPane para el doble
                                             buffer de los popups, y desde JDK 17 eso pide permiso: sin esto
                                             cada tooltip tira InaccessibleObjectException en el hilo de
                                             eventos. Vale solo para el jar; corriendo por -classpath hay que
                                             pasar a mano la opcion add-opens de java para ese paquete. -->
                                        <Add-Opens>java.desktop/javax.swing</Add-Opens>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
