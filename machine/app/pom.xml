<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fpetrola</groupId>
        <artifactId>machine</artifactId>
        <version>0.0.2-alu-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <packaging>jar</packaging>

    <name>app</name>

    <!--
      The program: the desktop, its windows and menus, the launcher, and main(). Everything that
      knows there is a person here.

      It sits on top of everything and nothing sits on it, which is the whole point: the emulator
      does not know this exists, and neither does a peripheral.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>zxinfo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>pokes</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>rzx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>ui</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
        </dependency>
        <!-- The peripherals this build offers. Nothing here names one; they arrive by service file. -->
        <!--
          The shapes a board's window is made of, and the interfaces the desktop plugs one into:
          the contract stays here, because a plugin has to be able to name it.
        -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>devices-kit</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
        </dependency>
        <!-- The ATA and MMC code six of the boards share, for the same reason the kit is here. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>devices-ide</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
        </dependency>
        <!--
          The boards themselves are NOT part of this: they arrive as jars in ~/.oozx/plugins, each
          published as a release of its own, and are found there rather than carried here. On the
          test classpath only, so what the tests exercise is the whole environment while what is
          shipped is the emulator with nothing plugged into it.
        -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>devices-all</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <!-- The fast core, which arrives the same way and makes itself on the first run. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>generated-core</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
        </dependency>
        <!-- The Slow tag, which lives in the most upstream module so every module shares it. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>emulator</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- The emulator's test harness and its ROMs, tapes and recordings. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>0.0.2-alu-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The scaler: see the note in ui's pom, which explains why it is a dependency and not a copy. -->
        <dependency>
            <groupId>io.github.stanio</groupId>
            <artifactId>xbrz-core</artifactId>
            <version>1.8.2</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-transcoder</artifactId>
            <version>1.17</version>
        </dependency>
        <!-- The look and feel, and the markdown a game's notes are written in: both are the
             desktop's own, and both used to arrive through core because the windows started there. -->
        <dependency>
            <groupId>com.github.weisj</groupId>
            <artifactId>darklaf-core</artifactId>
            <version>3.0.2</version>
        </dependency>
        <!-- The other look and feel families the Look&Feel menu offers. -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.6</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-intellij-themes</artifactId>
            <version>3.6</version>
        </dependency>
        <dependency>
            <groupId>com.jgoodies</groupId>
            <artifactId>jgoodies-looks</artifactId>
            <version>2.7.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.vincenzopalazzo</groupId>
            <artifactId>material-ui-swing</artifactId>
            <version>1.1.4</version>
        </dependency>
        <dependency>
            <groupId>org.pushing-pixels</groupId>
            <artifactId>radiance-theming</artifactId>
            <version>7.5.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.21.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>0.21.0</version>
        </dependency>
    </dependencies>

    <!-- Un solo jar ejecutable: mvn -o package -pl machine/app -am -DskipTests
         y despues java -jar machine/app/target/app-<version>.jar
         Los perifericos llegan por service file, asi que las entradas de META-INF/services
         de todos los modulos se concatenan en vez de pisarse. -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.fpetrola.oozx.speccy.desktop.OOSpectrumLauncher</mainClass>
                                    <manifestEntries>
                                        <!-- El look and feel entra por reflexion a JRootPane para el doble
                                             buffer de los popups, y desde JDK 17 eso pide permiso: sin esto
                                             cada tooltip tira InaccessibleObjectException en el hilo de
                                             eventos. Vale solo para el jar; corriendo por -classpath hay que
                                             pasar a mano la opcion add-opens de java para ese paquete. -->
                                        <Add-Opens>java.desktop/javax.swing</Add-Opens>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <!-- The slow, networked and native-only tests never run in a normal build. Ask for them:
         mvn test -Pslow -pl machine/app -->
    <profiles>
        <profile>
            <id>slow</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/suites/SlowSuite.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <oozx.slow>true</oozx.slow>
                                <oozx.network>true</oozx.network>
                                <oozx.native>true</oozx.native>
                            </systemPropertyVariables>
                            <forkedProcessTimeoutInSeconds>1800</forkedProcessTimeoutInSeconds>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
