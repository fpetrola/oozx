<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fpetrola</groupId>
        <artifactId>machine</artifactId>
        <version>0.0.2-alu-SNAPSHOT</version>
    </parent>

    <artifactId>machines</artifactId>
    <packaging>jar</packaging>

    <name>The machines beyond the five the emulator is built on: variants and clones</name>

    <!--
      The machines, and what each has on its board: the ULA, the 128's pager, the AY, the +3's
      drive and the Pentagon's Beta, each in a module of its own under here. A machine names its
      parts by class, so this depends on those modules; a device somebody plugs in lives in
      devices and is found through META-INF/services instead.
    -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>device-ula</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>device-ay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>device-memory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>device-disk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The emulator's test harness: a machine to run a test on, and the loops that run it. -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
