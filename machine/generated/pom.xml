<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fpetrola</groupId>
        <artifactId>machine</artifactId>
        <version>0.0.2-alu-SNAPSHOT</version>
    </parent>

    <artifactId>generated-core</artifactId>
    <packaging>jar</packaging>

    <name>generated core</name>

    <!--
      The fast core, generated by reading the OOP model: the specializer, the generator, and the
      generated core as the emulator's processor. The base of the emulator does not depend on this
      and does not know it exists. The generated core is an ordinary source of this module: the
      build writes it again whenever the sources that shape it change, and the compiler does the
      rest, so nothing is generated or compiled when somebody runs the emulator.
    -->
    <dependencies>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>machines</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>machines</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
        </dependency>

        <!-- test: the CPU batteries and the Slow tag, and the machine harness -->
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>emulator</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fpetrola</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- What the emulator's batteries need to run here: their JUnit 4 side, the emustudio suite and its mocks. -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.emustudio</groupId>
            <artifactId>cpu-testsuite_12.0</artifactId>
            <version>1.2.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.easymock</groupId>
            <artifactId>easymock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.exemplary.guice</groupId>
            <artifactId>guice-behave</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <!--
          The model goes in the jar as source: it is what the generator reads at run time. It is
          copied under target first and declared as a resource from there, because a resource
          directory that is another module's source directory becomes, in an IDE, a root of this
          module and stops being one of that module.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.build.directory}/model-sources</directory>
                <targetPath>META-INF/model-sources</targetPath>
            </resource>
            <!--
              The generator's own sources, because what the written core came from is the model and
              the generator both. Its sources and not its classes: two JDKs compile the same source
              to different bytes, and the key went with them.
            -->
            <resource>
                <directory>src/main/java</directory>
                <targetPath>META-INF/generator-sources</targetPath>
                <excludes>
                    <exclude>**/GeneratedSpectrumZ80.java</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>model-sources</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/model-sources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>../../emulator/src/main/java</directory>
                                </resource>
                                <resource>
                                    <directory>../core/src/main/java</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <!--
              The generated core is written here, in a forked JVM so that neither its heap nor the
              machine it builds to read is Maven's. It writes nothing unless the model changed -
              the file says which model it came from - so the build that changes the model is the
              one that pays for it, and every other build and every run of the emulator find it
              written and compiled.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>package-the-core</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <classpathScope>compile</classpathScope>
                            <arguments>
                                <argument>-Xmx1g</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.fpetrola.oozx.generated.GeneratedCores</argument>
                                <argument>${project.basedir}/src/main/java/com/fpetrola/oozx/generated/GeneratedSpectrumZ80.java</argument>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <forkedProcessTimeoutInSeconds>900</forkedProcessTimeoutInSeconds>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
