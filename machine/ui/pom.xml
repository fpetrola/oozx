<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fpetrola</groupId>
        <artifactId>machine</artifactId>
        <version>0.0.2-alu-SNAPSHOT</version>
    </parent>

    <artifactId>ui</artifactId>
    <packaging>jar</packaging>

    <name>ui</name>

    <!--
      Windows, and what draws a Spectrum's picture in one. Below both the emulator and the
      peripherals on purpose: a peripheral that brings its own window - the printer's paper, the
      mouse's pointer - needs the frame that clips onto a machine, and if that frame lived in the
      application then the application would depend on the peripheral that depends on it.

      This module depends on NOTHING of the emulator, which is what keeps that true. If something
      here ever needs to ask a machine a question, the answer is a listener, not a dependency.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
          xBRZ, the pixel-art scaler, as a Java port by Stanio of Zenju's original.

          NOT Apache 2.0 like the rest of this: xbrz-core is under the GNU General Public
          License v3, and it is here as an UNMODIFIED dependency and not copied into this tree,
          which is what its linking exception allows - the port grants permission to link it
          with independent modules and distribute the result under terms of your choice.
          Modifying it would put the modification under the GPL, so do not; and whatever this
          project ships has to carry the library's own licence and attribution with it.

          There is a scaler here that needs none of that, and there always will be.
        -->
        <dependency>
            <groupId>io.github.stanio</groupId>
            <artifactId>xbrz-core</artifactId>
            <version>1.8.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.xmlgraphics</groupId>
            <artifactId>batik-transcoder</artifactId>
            <version>1.17</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
